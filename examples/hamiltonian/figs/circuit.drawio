<mxCell id="c29" value="b" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1a365d;fontSize=13;fontFamily=Helvetica;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="18" y="380" width="58" height="24" as="geometry"/></mxCell>
