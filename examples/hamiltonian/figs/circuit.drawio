<mxCell id="c40" value="+" style="ellipse;fillColor=#ffffff;strokeColor=#1a365d;html=1;fontSize=18;fontColor=#1a365d;fontFamily=Helvetica;verticalAlign=middle;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="362" y="380" width="24" height="24" as="geometry"/></mxCell>
<mxCell id="c41" value="Rx(-π/2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="428" y="301" width="72" height="34" as="geometry"/></mxCell>
<mxCell id="c42" value="Rx(-π/2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="428" y="375" width="72" height="34" as="geometry"/></mxCell>
<mxCell id="c43" value="&lt;b&gt;Why this works&lt;/b&gt;&lt;br&gt;1. CX maps X⊗I to X⊗X, and I⊗Z to Z⊗Z. So the middle three columns are exp(-i θ/2 (XX + ZZ)).&lt;br&gt;2. Rx(-π/2) Z Rx(π/2) = Y, and X stays X. So the outer columns turn ZZ into YY.&lt;br&gt;3. Neighbouring Rx(π/2) and Rx(-π/2) cancel, so the whole job needs them only at its two ends." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1a365d;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="286" width="540" height="146" as="geometry"/></mxCell>
<mxCell id="c44" value="Written out, the circuit has 2 CX a bond. The general recipe below gives 4: one Pauli gadget for XX, one for YY." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1a365d;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="414" width="470" height="40" as="geometry"/></mxCell>
<mxCell id="c45" style="endArrow=none;html=1;strokeColor=#e6ebf0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="466" as="sourcePoint"/><mxPoint x="1090" y="466" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c46" value="&lt;b&gt;The general recipe for one Pauli term, exp(-i θ/2 P), on any molecule or lattice&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1a365d;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="476" width="1080" height="28" as="geometry"/></mxCell>
<mxCell id="c47" value="Change basis:&lt;br&gt;X by H, Y by Rx(π/2)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6ebf0;strokeColor=#1a365d;fontColor=#1a365d;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="200" height="56" as="geometry"/></mxCell>
<mxCell id="c48" value="CX ladder:&lt;br&gt;parity on one qubit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="264" y="514" width="180" height="56" as="geometry"/></mxCell>
<mxCell id="c49" value="Rz(θ)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1a365d;strokeColor=none;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="468" y="514" width="90" height="56" as="geometry"/></mxCell>
<mxCell id="c50" value="The CX ladder,&lt;br&gt;in reverse" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="582" y="514" width="180" height="56" as="geometry"/></mxCell>
<mxCell id="c51" value="Undo the basis change" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6ebf0;strokeColor=#1a365d;fontColor=#1a365d;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="786" y="514" width="200" height="56" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
