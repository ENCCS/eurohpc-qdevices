<mxCell id="c23" value="The key reads q[2] q[1] q[0].&lt;br&gt;Start: &lt;b&gt;001&lt;/b&gt;&lt;br&gt;Arrival: &lt;b&gt;100&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1a365d;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="906" y="78" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="c24" value="A acts on q[0], q[1]; B acts on q[1], q[2]. Five bonds of 2 CX: 10 CX in all." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1a365d;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="222" y="202" width="524" height="26" as="geometry"/></mxCell>
<mxCell id="c25" style="endArrow=none;html=1;strokeColor=#e6ebf0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="240" as="sourcePoint"/><mxPoint x="1090" y="240" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c26" value="&lt;b&gt;One bond, on qubits a and b: exp(-i θ/2 (XX + YY)), with θ = dt or dt/2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1a365d;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="1080" height="28" as="geometry"/></mxCell>
