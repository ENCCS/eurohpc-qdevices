<mxfile><diagram name="pipeline"><mxGraphModel background="#ffffff" pageWidth="1090" pageHeight="450"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c1" value="&lt;b&gt;Atoms and molecules&lt;/b&gt;&lt;br&gt;electrons in orbitals, mapped to Pauli terms by Jordan-Wigner" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e6ebf0;strokeColor=#1a365d;fontColor=#1a365d;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="235" height="104" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;1. The Hamiltonian&lt;/b&gt;&lt;br&gt;H, a sum of terms on few qubits" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="30" width="235" height="104" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;2. A product formula&lt;/b&gt;&lt;br&gt;exp(-iHt) as N short steps; the error comes from commutators" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="30" width="235" height="104" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;3. The gates&lt;/b&gt;&lt;br&gt;each step as CX and rotations, in an OpenQASM 2 text, by hand or by Qrisp" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="30" width="235" height="104" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;4. qdevices&lt;/b&gt;&lt;br&gt;a dry run offline, then one send, with a record on disk" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#007a83;strokeColor=none;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="175" width="235" height="104" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;5. Euro-Q-Exa&lt;/b&gt;&lt;br&gt;compiles the text to r and CZ, picks the qubits, runs the shots" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#007a83;strokeColor=none;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="175" width="235" height="104" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;6. The counts&lt;/b&gt;&lt;br&gt;the share of each key, raw and with the conservation check" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#007a83;strokeColor=none;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="235" height="104" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;The exact answer&lt;/b&gt;&lt;br&gt;a closed form here; QuTiP for small systems" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e6ebf0;strokeColor=#1a365d;fontColor=#1a365d;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="175" width="235" height="104" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;7. Compare&lt;/b&gt;&lt;br&gt;measured against the text and against the exact answer" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1a365d;strokeColor=none;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="235" height="104" as="geometry"/></mxCell>
