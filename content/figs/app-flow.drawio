<mxfile><diagram name="app-flow"><mxGraphModel background="#ffffff" pageWidth="1040" pageHeight="260"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="app" value="qdevices, on your computer" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#c5d0dc;fontColor=#1a365d;fontSize=14;fontStyle=1;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="165" y="0" width="590" height="255" as="geometry"/></mxCell>
<mxCell id="you" value="&lt;b style=&quot;font-size:16px&quot;&gt;You&lt;/b&gt;&lt;br&gt;&lt;br&gt;circuit texts, from Qrisp or by hand&lt;br&gt;&lt;br&gt;a manifest of the jobs&lt;br&gt;&lt;br&gt;your limits" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1a365d;strokeColor=none;fontColor=#ffffff;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="130" height="205" as="geometry"/></mxCell>
<mxCell id="dry" value="&lt;b&gt;dry-run&lt;/b&gt;&lt;br&gt;checks the files, the shots and the project; offline" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=14;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="185" y="40" width="165" height="90" as="geometry"/></mxCell>
<mxCell id="check" value="&lt;b&gt;check --live&lt;/b&gt;&lt;br&gt;reads the machine once; no job" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=14;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="40" width="165" height="90" as="geometry"/></mxCell>
<mxCell id="send" value="&lt;b&gt;send --live&lt;/b&gt;&lt;br&gt;one job at a time, each text unchanged" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2b5797;strokeColor=none;fontColor=#ffffff;fontSize=14;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="575" y="40" width="165" height="90" as="geometry"/></mxCell>
